FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Malla de fondo para snappyHexMesh (Tarea 2): el canal completo, sin cilindro.
// El cilindro lo recorta snappyHexMesh (system/snappyHexMeshDict).

#include "${FOAM_CASE}/constant/Parametros"

nx      #calc "label(round($L / $dx))";
ny      #calc "label(round($H / $dx))";
nz      1;

vertices
(
    (0  0  0)        // 0
    ($L 0  0)        // 1
    ($L $H 0)        // 2
    (0  $H 0)        // 3
    (0  0  $zBack)   // 4
    ($L 0  $zBack)   // 5
    ($L $H $zBack)   // 6
    (0  $H $zBack)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type    patch;
        faces   ((0 4 7 3));
    }

    outlet
    {
        type    patch;
        faces   ((1 2 6 5));
    }

    lowerWall
    {
        type    wall;
        faces   ((0 1 5 4));
    }

    upperWall
    {
        type    wall;
        faces   ((3 7 6 2));
    }

    // front y back quedan como "patch" aqui; extrudeMesh los convierte en empty
    front
    {
        type    patch;
        faces   ((0 3 2 1));
    }

    back
    {
        type    patch;
        faces   ((4 5 6 7));
    }
);

