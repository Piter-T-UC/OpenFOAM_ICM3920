FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "${FOAM_CASE}/constant/Parametros"

dimensions      [velocity];

internalField   uniform ($Uin 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ($Uin 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform ($Uin 0 0);
    }
    "(lowerWall|upperWall|cylinder)"
    {
        type            noSlip;
    }
    "(front|back)"
    {
        type            empty;
    }
}

