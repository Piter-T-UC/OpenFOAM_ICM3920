// Flujo alrededor de un cilindro dentro de un canal recto (Tarea 2).
// Este es el UNICO archivo que hay que editar: lo leen blockMeshDict,
// snappyHexMeshDict, extrudeMeshDict, controlDict, physicalProperties y 0/U.
//
//      y
//      ^   upperWall
//    H +--------------------------------------------------+
//      |                                                  |
// inlet|                                                  |outlet
//  --> |             (o)  yc = H/2                        |
//      |                                                  |
//      |                                                  |
//    0 +--------------------------------------------------+--> x
//      0   lowerWall  xc = Lup                     Lup + Ldown

// ---------------------------------------------------------------------------
// Geometria [m]
// ---------------------------------------------------------------------------
D       1;                      // diametro del cilindro (longitud de referencia)
R       #calc "0.5 * $D";       // radio del cilindro

H       #calc "4.0 * $D";       // altura del canal (bloqueo D/H = 25 %)

Lup     #calc "5.0 * $D";       // <-- TU ELIGES: distancia del inlet al CENTRO del cilindro
Ldown   #calc "15.0 * $D";      // distancia del centro del cilindro al outlet

xc      $Lup;                   // centro del cilindro en x
yc      #calc "0.5 * $H";       // centro del cilindro en y (mitad de la altura)
L       #calc "$Lup + $Ldown";  // largo total del canal


// ---------------------------------------------------------------------------
// Flujo
// ---------------------------------------------------------------------------
Re      100;                            // Reynolds basado en D y Uin  <-- cambiar aqui
nu      1.8440831253e-05;               // viscosidad cinematica del aire [m2/s]
Uin     #calc "$Re * $nu / $D";         // velocidad uniforme de entrada [m/s]

nTc     200;                            // duracion de la simulacion en tiempos convectivos D/Uin

// ---------------------------------------------------------------------------
// Malla (blockMesh de fondo + snappyHexMesh + extrudeMesh)
// ---------------------------------------------------------------------------
// Malla de fondo: celdas cubicas de lado dx (snappy refina dividiendo cada
// celda en 8, por eso el espesor en z es igual a dx).
dx      #calc "$D / 10.0";
zBack   $dx;                    // espesor en z (caso 2D)

// Zona de refinamiento en la estela (caja). Tamano de celda = dx / 2^wakeLevel
wakeXmin    #calc "$xc - 1.5 * $D";
wakeXmax    #calc "$xc + 8.0 * $D";
wakeYmin    #calc "$yc - 1.5 * $D";
wakeYmax    #calc "$yc + 1.5 * $D";
wakeLevel   2;

// ===================== REFINAMIENTO EN LA PARED DEL CILINDRO ================
// ========================= ESTO LO CALCULAS TU ==============================
// cylLevelMin/Max : nivel de refinamiento de snappy en la superficie del cilindro.
//                   Tamano de celda junto al cilindro: dn = dx / 2^nivel
// nLayers         : numero de capas prismaticas pegadas a la pared (addLayers)
// expansionRatio  : razon de crecimiento entre capas consecutivas (er)
// firstLayerThickness : espesor de la primera capa t1 [m] (relativeSizes false)
//
// Formulas utiles:
//     espesor total de las capas : T  = t1 * (er^nLayers - 1) / (er - 1)
//     espesor de la ultima capa  : tN = t1 * er^(nLayers - 1)
//     conviene que tN sea parecido a dn para que la transicion sea suave.
//
// Los valores de abajo son SOLO un placeholder para que la malla se genere.
cylLevelMin         3;                      // <-- TU CALCULAS
cylLevelMax         3;                      // <-- TU CALCULAS
nLayers             10;                     // <-- TU CALCULAS
expansionRatio      1.2;                    // <-- TU CALCULAS
firstLayerThickness #calc "0.0025 * $D";    // <-- TU CALCULAS
// ============================================================================

